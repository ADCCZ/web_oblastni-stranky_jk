{block content}

<section class="profile-section">
    <div class="profile-container">
        {* Header *}
        <div class="admin-header scroll-reveal">
            <div class="admin-header-content">
                <h1 class="admin-title font-display">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    Moje děti
                </h1>
                <a n:href="Profile:" class="admin-back-link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Zpět na profil
                </a>
            </div>
        </div>

        {* Hint *}
        <div class="profile-card scroll-reveal" style="margin-bottom: 20px;">
            <div class="profile-card-body" style="padding: 14px 20px;">
                <p class="profile-extended-hint" style="margin-bottom: 0;">
                    Zde můžete spravovat údaje o svých dětech. Při registraci na akci si vyberete, zda registrujete sebe nebo některé z dětí, a údaje se automaticky předvyplní.
                </p>
            </div>
        </div>

        {* Children list *}
        <div id="children-list" data-save-url="{$presenter->link('saveChild!')}">
            {foreach $children as $child}
                <div class="profile-card scroll-reveal child-card" data-child-id="{$child->id}" style="margin-bottom: 20px;">
                    <div class="profile-card-header">
                        <h2 class="profile-card-title">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            {$child->first_name} {$child->last_name}
                        </h2>
                        <div style="display: flex; gap: 8px;">
                            <button type="button" class="profile-edit-btn" onclick="toggleChildEdit({$child->id}, true)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                                Upravit
                            </button>
                            <a n:href="deleteChild!, childId => $child->id" class="profile-edit-btn" style="color: #ef4444;" onclick="return confirm('Opravdu chcete odebrat {$child->first_name} {$child->last_name}?')">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </a>
                        </div>
                    </div>

                    {* View mode *}
                    <div class="profile-card-body child-view-{$child->id}">
                        <div class="profile-field">
                            <label>Datum narození</label>
                            <span>{if $child->birth_date}{$child->birth_date|date:'j. n. Y'}{else}Nevyplněno{/if}</span>
                        </div>
                        <div class="profile-field">
                            <label>Klub Pathfinder</label>
                            <span>{if $child->is_pathfinder_member}Registrován{else}Neregistrován{/if}</span>
                        </div>
                        {if $child->phone}
                        <div class="profile-field">
                            <label>Telefon</label>
                            <span>{$child->phone}</span>
                        </div>
                        {/if}
                        {if $child->email}
                        <div class="profile-field">
                            <label>Email</label>
                            <span>{$child->email}</span>
                        </div>
                        {/if}
                        {if $child->street || $child->city}
                        <div class="profile-field">
                            <label>Adresa</label>
                            <span>{$child->street}{if $child->city}, {$child->city}{/if}{if $child->zip} {$child->zip}{/if}</span>
                        </div>
                        {/if}
                        {if $child->allergies}
                        <div class="profile-field">
                            <label>Alergie</label>
                            <span>{$child->allergies}</span>
                        </div>
                        {/if}
                        {if $child->health_notes}
                        <div class="profile-field">
                            <label>Zdravotní požadavky</label>
                            <span>{$child->health_notes}</span>
                        </div>
                        {/if}
                    </div>

                    {* Edit mode *}
                    <div class="profile-card-body child-edit-{$child->id}" style="display: none;">
                        <form class="child-form" data-child-id="{$child->id}">
                            {include childFormFields, child => $child}
                            <div class="profile-edit-actions">
                                <button type="submit" class="profile-form-submit">Uložit</button>
                                <button type="button" class="profile-edit-cancel" onclick="toggleChildEdit({$child->id}, false)">Zrušit</button>
                            </div>
                        </form>
                    </div>
                </div>
            {/foreach}
        </div>

        {* Add child button *}
        <div class="scroll-reveal" style="margin-top: 20px;">
            <button type="button" id="add-child-btn" class="profile-form-submit" style="width: 100%; padding: 14px; font-size: 1rem;" onclick="showNewChildForm()">
                <svg style="width: 20px; height: 20px; display: inline; vertical-align: middle; margin-right: 6px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Přidat dítě
            </button>
        </div>

        {* New child form (hidden) *}
        <div id="new-child-card" class="profile-card" style="display: none; margin-top: 20px;">
            <div class="profile-card-header">
                <h2 class="profile-card-title">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                    </svg>
                    Nové dítě
                </h2>
            </div>
            <div class="profile-card-body">
                <form class="child-form" data-child-id="0">
                    {include childFormFields, child => null}
                    <div class="profile-edit-actions">
                        <button type="submit" class="profile-form-submit">Přidat</button>
                        <button type="button" class="profile-edit-cancel" onclick="hideNewChildForm()">Zrušit</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</section>

{define childFormFields}
    <div class="profile-form-row">
        <div class="profile-form-group">
            <label class="profile-form-label">Jméno <span style="color: #ef4444;">*</span></label>
            <input type="text" name="first_name" class="profile-form-input" value="{$child ? $child->first_name : ''}" required>
        </div>
        <div class="profile-form-group">
            <label class="profile-form-label">Příjmení <span style="color: #ef4444;">*</span></label>
            <input type="text" name="last_name" class="profile-form-input" value="{$child ? $child->last_name : ''}" required>
        </div>
    </div>
    <div class="profile-form-row">
        <div class="profile-form-group">
            <label class="profile-form-label">Datum narození</label>
            <input type="date" name="birth_date" class="profile-form-input" value="{$child && $child->birth_date ? $child->birth_date->format('Y-m-d') : ''}">
        </div>
        <div class="profile-form-group">
            <label class="profile-form-label">Telefon</label>
            <input type="tel" name="phone" class="profile-form-input" value="{$child ? $child->phone : ''}">
        </div>
    </div>
    <div class="profile-form-group">
        <label class="profile-form-label">Email</label>
        <input type="email" name="email" class="profile-form-input" value="{$child ? $child->email : ''}">
    </div>

    <h3 class="profile-subsection-title">Adresa</h3>
    <div class="profile-form-group">
        <label class="profile-form-label">Ulice a č.p.</label>
        <input type="text" name="street" class="profile-form-input" value="{$child ? $child->street : ''}">
    </div>
    <div class="profile-form-row">
        <div class="profile-form-group">
            <label class="profile-form-label">Město</label>
            <input type="text" name="city" class="profile-form-input" value="{$child ? $child->city : ''}">
        </div>
        <div class="profile-form-group" style="max-width: 150px;">
            <label class="profile-form-label">PSČ</label>
            <input type="text" name="zip" class="profile-form-input" maxlength="10" value="{$child ? $child->zip : ''}">
        </div>
    </div>

    <h3 class="profile-subsection-title">Osobní</h3>
    <div class="auth-checkbox-group" style="margin-top: 0.5rem;">
        <label class="auth-checkbox-label">
            <input type="checkbox" name="is_pathfinder_member" value="1" class="auth-checkbox" {if $child && $child->is_pathfinder_member}checked{/if}>
            <span>Registrován v Klubu Pathfinder</span>
        </label>
    </div>

    <h3 class="profile-subsection-title">Zdraví a stravování</h3>
    <div class="auth-checkbox-group" style="margin-top: 0.5rem;">
        <label class="auth-checkbox-label">
            <input type="checkbox" name="is_vegetarian" value="1" class="auth-checkbox" {if $child && $child->is_vegetarian}checked{/if}>
            <span>Vegetarián</span>
        </label>
    </div>
    <div class="profile-form-group">
        <label class="profile-form-label">Stravovací návyky</label>
        <input type="text" name="dietary_notes" class="profile-form-input" value="{$child ? $child->dietary_notes : ''}" placeholder="Např. bezlepková dieta...">
    </div>
    <div class="profile-form-group">
        <label class="profile-form-label">Alergie</label>
        <input type="text" name="allergies" class="profile-form-input" value="{$child ? $child->allergies : ''}" placeholder="Např. pyly, ořechy...">
    </div>
    <div class="profile-form-group">
        <label class="profile-form-label">Zdravotní požadavky</label>
        <input type="text" name="health_notes" class="profile-form-input" value="{$child ? $child->health_notes : ''}" placeholder="Např. astma, diabetes...">
    </div>
    <div class="profile-form-group">
        <label class="profile-form-label">Léky</label>
        <input type="text" name="medications" class="profile-form-input" value="{$child ? $child->medications : ''}" placeholder="Pravidelně užívané léky...">
    </div>
    <div class="profile-form-group">
        <label class="profile-form-label">Umí plavat</label>
        <select name="can_swim" class="profile-form-input">
            <option value="">-- Nevyplněno --</option>
            <option value="1" {if $child && $child->can_swim !== null && $child->can_swim}selected{/if}>Ano</option>
            <option value="0" {if $child && $child->can_swim !== null && !$child->can_swim}selected{/if}>Ne</option>
        </select>
    </div>
    <div class="profile-form-group">
        <label class="profile-form-label">Velikost oblečení</label>
        <input type="text" name="clothing_size" class="profile-form-input" maxlength="10" value="{$child ? $child->clothing_size : ''}" placeholder="Např. 140, S, M...">
    </div>

    <div class="child-form-errors" style="display: none; margin-top: 12px;"></div>
{/define}

<script>
var saveChildUrl = document.getElementById('children-list').dataset.saveUrl;

function toggleChildEdit(childId, show) {
    document.querySelector('.child-view-' + childId).style.display = show ? 'none' : 'block';
    document.querySelector('.child-edit-' + childId).style.display = show ? 'block' : 'none';
}

function showNewChildForm() {
    document.getElementById('new-child-card').style.display = 'block';
    document.getElementById('add-child-btn').style.display = 'none';
    document.getElementById('new-child-card').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function hideNewChildForm() {
    document.getElementById('new-child-card').style.display = 'none';
    document.getElementById('add-child-btn').style.display = 'block';
}

document.addEventListener('DOMContentLoaded', function() {
    // Style native selects
    if (typeof initStyledSelects === 'function') {
        initStyledSelects('.profile-container');
    }

    document.querySelectorAll('.child-form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            var childId = parseInt(form.dataset.childId);
            var errDiv = form.querySelector('.child-form-errors');

            var data = {
                id: childId || undefined,
                first_name: form.querySelector('[name="first_name"]').value,
                last_name: form.querySelector('[name="last_name"]').value,
                birth_date: form.querySelector('[name="birth_date"]').value,
                phone: form.querySelector('[name="phone"]').value,
                email: form.querySelector('[name="email"]').value,
                street: form.querySelector('[name="street"]').value,
                city: form.querySelector('[name="city"]').value,
                zip: form.querySelector('[name="zip"]').value,
                is_pathfinder_member: form.querySelector('[name="is_pathfinder_member"]').checked ? 1 : 0,
                is_vegetarian: form.querySelector('[name="is_vegetarian"]').checked ? 1 : 0,
                dietary_notes: form.querySelector('[name="dietary_notes"]').value,
                allergies: form.querySelector('[name="allergies"]').value,
                health_notes: form.querySelector('[name="health_notes"]').value,
                medications: form.querySelector('[name="medications"]').value,
                can_swim: form.querySelector('[name="can_swim"]').value,
                clothing_size: form.querySelector('[name="clothing_size"]').value
            };

            var btn = form.querySelector('[type="submit"]');
            btn.disabled = true;
            btn.textContent = 'Ukládám...';
            if (errDiv) errDiv.style.display = 'none';

            fetch(saveChildUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(resp) {
                btn.disabled = false;
                btn.textContent = childId ? 'Uložit' : 'Přidat';
                if (resp.success) {
                    if (typeof showToast === 'function') showToast(resp.message, 'success');
                    setTimeout(function() { window.location.reload(); }, 500);
                } else {
                    if (errDiv) {
                        errDiv.innerHTML = '<div class="auth-error"><ul>' + (resp.errors || ['Chyba.']).map(function(e) { return '<li>' + e + '</li>'; }).join('') + '</ul></div>';
                        errDiv.style.display = 'block';
                    }
                }
            })
            .catch(function() {
                btn.disabled = false;
                btn.textContent = childId ? 'Uložit' : 'Přidat';
                if (errDiv) {
                    errDiv.innerHTML = '<div class="auth-error"><ul><li>Chyba při ukládání.</li></ul></div>';
                    errDiv.style.display = 'block';
                }
            });
        });
    });
});
</script>

{/block}
