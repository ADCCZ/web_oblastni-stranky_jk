{block content}

<section class="event-detail-section">
    <div class="event-detail-container">
        {* Back link *}
        <div class="event-detail-back scroll-reveal">
            <a n:href="Event:default" class="event-back-link">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Zpět na seznam akcí
            </a>
        </div>

        {* Two-column layout: image left, info right *}
        <div class="event-detail-layout scroll-reveal">
            {* Left column - image / PDF *}
            <div class="event-detail-left">
                {if $event->image_path}
                    {if str_ends_with($event->image_path, '.pdf')}
                        <div class="event-detail-image-wrapper">
                            <canvas data-pdf-src="{$basePath}/{$event->image_path}"></canvas>
                            <div class="pdf-fallback bg-gradient-to-br from-primary-light to-primary" style="display:none; width:100%; height:100%; align-items:center; justify-content:center; border-radius:12px;">
                                <span class="text-white/30">
                                    <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                                    </svg>
                                </span>
                            </div>
                        </div>
                        <a href="{$basePath}/{$event->image_path}" target="_blank" rel="noopener" class="event-pdf-download-link">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            Otevřít PDF
                        </a>
                    {else}
                        <div class="event-detail-image-wrapper">
                            <img src="{$basePath}/{$event->image_path}" alt="{$event->title}">
                        </div>
                    {/if}
                {else}
                    <div class="event-detail-image-wrapper event-detail-placeholder bg-gradient-to-br from-primary-light to-primary">
                        <span class="text-white/30">
                            <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </span>
                    </div>
                {/if}
            </div>

            {* Right column - info *}
            <div class="event-detail-right">
                {* Title with category badge inline *}
                <div class="event-title-row">
                    <h1 class="event-detail-title font-display text-gray-900 dark:text-white">{$event->title}</h1>
                    {if $event->category}
                        <span class="event-title-badge" style="background: {$event->category->color|noescape};">{$event->category->name}</span>
                    {/if}
                    {if $event->availability === 'leaders'}
                        <span class="event-availability-badge">Pro vůdce</span>
                    {else}
                        <span class="event-availability-badge-all">Pro děti</span>
                    {/if}
                </div>
                {if $event->description}
                    <p class="event-detail-description text-gray-600 dark:text-gray-300">{$event->description}</p>
                {/if}

                {* Info items (compact list) *}
                <div class="event-detail-info-list">
                    <div class="event-info-item">
                        <svg class="w-5 h-5 event-info-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <div>
                            <span class="event-info-item-label text-gray-500 dark:text-gray-400">Datum</span>
                            <span class="event-info-item-value text-gray-900 dark:text-white">
                                {$event->start_date|date:'j. n. Y, H:i'}
                                {if $event->end_date}
                                    — {$event->end_date|date:'j. n. Y, H:i'}
                                {/if}
                            </span>
                        </div>
                    </div>

                    {if $event->location}
                        <div class="event-info-item">
                            <svg class="w-5 h-5 event-info-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            <div>
                                <span class="event-info-item-label text-gray-500 dark:text-gray-400">Místo</span>
                                <span class="event-info-item-value text-gray-900 dark:text-white">
                                    {if $event->location_url}
                                        <a href="{$event->location_url}" target="_blank" rel="noopener noreferrer" class="event-location-link">
                                            {$event->location}
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline; vertical-align:middle; margin-left:4px;">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                            </svg>
                                        </a>
                                    {else}
                                        {$event->location}
                                    {/if}
                                </span>
                            </div>
                        </div>
                    {/if}

                    {if $event->price !== null}
                        <div class="event-info-item">
                            <svg class="w-5 h-5 event-info-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <div>
                                <span class="event-info-item-label text-gray-500 dark:text-gray-400">Cena</span>
                                <span class="event-info-item-value text-gray-900 dark:text-white">
                                    {if $event->price == 0}Zdarma{else}{$event->price} Kč{/if}
                                </span>
                            </div>
                        </div>
                    {/if}

                    {if $event->capacity && $canManage}
                        <div class="event-info-item">
                            <svg class="w-5 h-5 event-info-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            <div>
                                <span class="event-info-item-label text-gray-500 dark:text-gray-400">Kapacita</span>
                                <span class="event-info-item-value text-gray-900 dark:text-white">{$event->capacity}</span>
                            </div>
                        </div>
                    {/if}

                    {if $event->registration_to}
                        <div class="event-info-item">
                            <svg class="w-5 h-5 event-info-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <div>
                                <span class="event-info-item-label text-gray-500 dark:text-gray-400">Registrace do</span>
                                <span class="event-info-item-value text-gray-900 dark:text-white">
                                    {$event->registration_to|date:'j. n. Y'}
                                </span>
                            </div>
                        </div>
                    {/if}
                </div>

                {* Registration button *}
                {if $event->registration_type === 'external' && $event->form_url}
                    <div class="event-detail-actions">
                        <a href="{$event->form_url}" target="_blank" rel="noopener noreferrer" class="event-form-link-btn">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                            {$event->form_button_text ?: 'Přihlásit se'}
                        </a>
                    </div>
                {elseif $event->registration_type === 'internal' && $event->form_template_id}
                    <div class="event-detail-actions">
                        <a n:href="Registration:form, eventId => $event->id" class="event-form-link-btn">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            {$event->form_button_text ?: 'Registrovat se'}
                        </a>
                        {if $canManage}
                            <a n:href="Registration:list, eventId => $event->id" class="event-registrations-manage-link">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                </svg>
                                Zobrazit registrace ({$registrationCount})
                            </a>
                        {/if}
                    </div>
                {/if}
            </div>
        </div>

        {* Event content - full width below *}
        {if $event->content}
            <div class="event-detail-content scroll-reveal bg-white dark:bg-gray-800">
                <div class="event-content-body text-gray-700 dark:text-gray-300">
                    {$event->content|noescape}
                </div>
            </div>
        {/if}
    </div>
</section>

{/block}
