{block content}

<section class="admin-section">
    <div class="admin-container" style="max-width: 1000px;">
        {* Header *}
        <div class="admin-header scroll-reveal">
            <div class="admin-header-content">
                <h1 class="admin-title font-display">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    {if $editId}Upravit šablonu{else}Nová šablona{/if}
                </h1>
                <a n:href="FormTemplate:" class="admin-back-link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Zpět na seznam
                </a>
            </div>
        </div>

        {* Metadata *}
        <div class="profile-card scroll-reveal">
            <div class="profile-card-header">
                <h2 class="profile-card-title">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Základní údaje
                </h2>
            </div>
            <div class="profile-card-body">
                <div class="profile-form-group">
                    <label class="profile-form-label">Název šablony *</label>
                    <input type="text" id="template-name" class="profile-form-input" placeholder="Např. Registrace na víkendovku">
                </div>
                <div class="profile-form-group">
                    <label class="profile-form-label">Popis <span class="auth-label-optional">(volitelné)</span></label>
                    <textarea id="template-description" class="profile-form-input" rows="2" placeholder="Stručný popis k čemu šablona slouží"></textarea>
                </div>
            </div>
        </div>

        {* Field palette *}
        <div class="profile-card scroll-reveal">
            <div class="profile-card-header">
                <h2 class="profile-card-title">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Přidat pole
                </h2>
            </div>
            <div class="profile-card-body">
                <div class="fb-palette">
                    <button type="button" class="fb-palette-btn" onclick="addField('text')" data-tooltip="Krátký textový vstup (jméno, email, adresa...)">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                        Text
                    </button>
                    <button type="button" class="fb-palette-btn" onclick="addField('textarea')" data-tooltip="Delší text na více řádků (poznámky, zprávy...)">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h10"/></svg>
                        Dlouhý text
                    </button>
                    <button type="button" class="fb-palette-btn" onclick="addField('number')" data-tooltip="Číselná hodnota (věk, počet osob...)">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>
                        Číslo
                    </button>
                    <button type="button" class="fb-palette-btn" onclick="addField('select')" data-tooltip="Rozbalovací seznam s výběrem jedné možnosti">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/></svg>
                        Výběr
                    </button>
                    <button type="button" class="fb-palette-btn" onclick="addField('radio')" data-tooltip="Skupina přepínačů - vybere se právě jedna možnost">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" stroke-width="2"/><circle cx="12" cy="12" r="8" stroke-width="2" fill="none"/></svg>
                        Radio
                    </button>
                    <button type="button" class="fb-palette-btn" onclick="addField('checkbox')" data-tooltip="Zaškrtávací políčko (ano/ne, souhlas...)">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Zaškrtávací
                    </button>
                    <button type="button" class="fb-palette-btn" onclick="addField('date')" data-tooltip="Výběr data z kalendáře">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        Datum
                    </button>
                    <div style="width: 100%; border-top: 1px solid rgba(0,0,0,0.08); margin: 4px 0;"></div>
                    <button type="button" class="fb-palette-btn" onclick="addField('info')" data-tooltip="Textový blok s popisem nebo instrukcemi - uživatel nevyplňuje">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Popisek
                    </button>
                    <button type="button" class="fb-palette-btn" onclick="addField('image')" data-tooltip="Zobrazí obrázek ve formuláři (zadejte URL) - uživatel nevyplňuje">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        Obrázek
                    </button>
                    <button type="button" class="fb-palette-btn" onclick="addField('youtube')" data-tooltip="Vloží YouTube video do formuláře (zadejte URL) - uživatel nevyplňuje">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        YouTube
                    </button>
                </div>
            </div>
        </div>

        {* System fields (always present, locked) *}
        <div class="profile-card scroll-reveal">
            <div class="profile-card-header">
                <h2 class="profile-card-title">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    Základní údaje <span style="font-weight: 400; font-size: 0.8rem; color: var(--text-gray);">(vždy ve formuláři)</span>
                </h2>
            </div>
            <div class="profile-card-body" style="padding: 12px 20px;">
                <div class="fb-system-fields">
                    <div class="fb-system-field">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        <span>Jméno <em>*</em></span>
                    </div>
                    <div class="fb-system-field">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        <span>Příjmení <em>*</em></span>
                    </div>
                    <div class="fb-system-field">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        <span>Člen Klubu Pathfinder <em>*</em></span>
                    </div>
                    <div class="fb-system-field">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        <span>Bydliště <em>*</em></span>
                    </div>
                    <div class="fb-system-field">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        <span>Datum narození <em>*</em></span>
                    </div>
                </div>
                <p style="font-size: 0.78rem; color: var(--text-gray); margin-top: 8px;">Tato pole jsou automaticky součástí každého formuláře a předvyplní se z profilu uživatele. Nelze je odebrat.</p>
            </div>
        </div>

        {* Profile-linked fields palette *}
        <div class="profile-card scroll-reveal">
            <div class="profile-card-header">
                <h2 class="profile-card-title">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    Profilové pole <span style="font-weight: 400; font-size: 0.8rem; color: var(--text-gray);">(předvyplní se z profilu, každé max. 1x)</span>
                </h2>
            </div>
            <div class="profile-card-body">
                <div class="fb-palette" id="profile-palette">
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="email" onclick="addProfileField('email')" data-tooltip="E-mail - předvyplní se z profilu uživatele">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        Email
                    </button>
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="phone" onclick="addProfileField('phone')" data-tooltip="Telefon - předvyplní se z profilu uživatele">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        Telefon
                    </button>
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="is_vegetarian" onclick="addProfileField('is_vegetarian')" data-tooltip="Zaškrtávací pole - předvyplní se z profilu">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Vegetarián
                    </button>
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="dietary_notes" onclick="addProfileField('dietary_notes')" data-tooltip="Text - předvyplní se z profilu">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                        Stravování
                    </button>
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="allergies" onclick="addProfileField('allergies')" data-tooltip="Text - předvyplní se z profilu">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                        Alergie
                    </button>
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="health_notes" onclick="addProfileField('health_notes')" data-tooltip="Text - předvyplní se z profilu">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                        Zdraví
                    </button>
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="medications" onclick="addProfileField('medications')" data-tooltip="Text - předvyplní se z profilu">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                        Léky
                    </button>
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="can_swim" onclick="addProfileField('can_swim')" data-tooltip="Výběr Ano/Ne - předvyplní se z profilu">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/></svg>
                        Umí plavat
                    </button>
                    <button type="button" class="fb-palette-btn fb-profile-btn" data-system-key="clothing_size" onclick="addProfileField('clothing_size')" data-tooltip="Text - předvyplní se z profilu">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                        Oblečení
                    </button>
                </div>
            </div>
        </div>

        {* Field canvas (custom fields) *}
        <div class="profile-card scroll-reveal" style="padding: 0;">
            <div class="profile-card-header">
                <h2 class="profile-card-title">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
                    </svg>
                    Vlastní pole
                </h2>
            </div>
        </div>
        <div id="field-canvas" class="fb-canvas">
            <div id="canvas-empty" class="fb-canvas-empty">
                <svg style="width: 48px; height: 48px; opacity: 0.3;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <p>Klikněte na typ pole výše pro přidání</p>
            </div>
        </div>

        {* Actions *}
        <div class="fb-actions scroll-reveal" style="display: flex; justify-content: flex-end; align-items: center; gap: 12px;">
            <a n:href="FormTemplate:" class="admin-action-btn admin-action-btn-danger" style="padding: 12px 24px;">Zrušit</a>
            <button type="button" id="save-btn" class="auth-submit-btn" onclick="saveTemplate()" style="max-width: 300px; margin: 0;"
                data-save-url="{$presenter->link('saveTemplate!')}"
                data-list-url="{$presenter->link('FormTemplate:')}">
                Uložit šablonu
            </button>
            <div id="save-status" style="margin-left: 8px; font-size: 0.85rem; display: none;"></div>
        </div>
    </div>
</section>

<script>
// ===== State =====
var fieldCounter = 0;
var state = {
    id: null,
    name: '',
    description: '',
    fields: []
};

var saveBtn = document.getElementById('save-btn');
var saveUrl = saveBtn.dataset.saveUrl;
var listUrl = saveBtn.dataset.listUrl;

// ===== Init =====
document.addEventListener('DOMContentLoaded', function() {
    var initial = {$templateJson|noescape};
    if (initial) {
        state.id = initial.id;
        document.getElementById('template-name').value = initial.name;
        document.getElementById('template-description').value = initial.description || '';
        initial.fields.forEach(function(f) {
            addField(f.fieldType, f);
        });
    }
    updateEmptyState();
    refreshProfilePalette();
});

// ===== Field type labels + descriptions =====
var typeLabels = {
    text: 'Text', textarea: 'Dlouhý text', number: 'Číslo',
    select: 'Výběr', radio: 'Radio', checkbox: 'Zaškrtávací', date: 'Datum',
    info: 'Popisek', image: 'Obrázek', youtube: 'YouTube'
};
var typeDescriptions = {
    text: 'Krátký textový vstup (jméno, email, adresa...)',
    textarea: 'Delší text na více řádků (poznámky, zprávy...)',
    number: 'Číselná hodnota (věk, počet osob...)',
    select: 'Rozbalovací seznam s výběrem jedné možnosti',
    radio: 'Skupina přepínačů - vybere se právě jedna možnost',
    checkbox: 'Zaškrtávací políčko (ano/ne, souhlas...)',
    date: 'Výběr data z kalendáře',
    info: 'Textový blok s popisem nebo instrukcemi (uživatel nevyplňuje)',
    image: 'Zobrazí obrázek ve formuláři (zadejte URL)',
    youtube: 'Vloží YouTube video do formuláře (zadejte URL)'
};
var displayOnlyTypes = ['info', 'image', 'youtube'];

// ===== Profile field definitions (system_key -> defaults) =====
var profileFieldDefs = {
    email:         { fieldType: 'text',     label: 'Email',                placeholder: '' },
    phone:         { fieldType: 'text',     label: 'Telefon',              placeholder: '' },
    is_vegetarian: { fieldType: 'checkbox', label: 'Vegetarián',           placeholder: '' },
    dietary_notes: { fieldType: 'text',     label: 'Stravovací návyky',    placeholder: 'Např. bezlepková dieta, veganství...' },
    allergies:     { fieldType: 'text',     label: 'Alergie',              placeholder: 'Např. pyly, ořechy, penicilin...' },
    health_notes:  { fieldType: 'text',     label: 'Zdravotní požadavky',  placeholder: 'Např. astma, diabetes...' },
    medications:   { fieldType: 'text',     label: 'Léky',                 placeholder: 'Pravidelně užívané léky...' },
    can_swim:      { fieldType: 'select',   label: 'Umí plavat',           placeholder: '', options: ['Ano', 'Ne'] },
    clothing_size: { fieldType: 'text',     label: 'Velikost oblečení',    placeholder: 'Např. 140, S, M, L...' }
};

function addProfileField(systemKey) {
    // Kontrola, zda uz neni pridano
    var exists = state.fields.some(function(f) { return f.systemKey === systemKey; });
    if (exists) return;

    var def = profileFieldDefs[systemKey];
    if (!def) return;

    addField(def.fieldType, {
        label: def.label,
        placeholder: def.placeholder || '',
        isRequired: false,
        options: def.options || [],
        systemKey: systemKey
    });

    refreshProfilePalette();
}

function refreshProfilePalette() {
    var btns = document.querySelectorAll('#profile-palette .fb-profile-btn');
    btns.forEach(function(btn) {
        var key = btn.dataset.systemKey;
        var used = state.fields.some(function(f) { return f.systemKey === key; });
        btn.disabled = used;
        btn.classList.toggle('fb-profile-btn-used', used);
    });
}

// ===== Add field =====
function addField(type, existing) {
    fieldCounter++;
    var localId = 'field_' + fieldCounter;

    var field = {
        localId: localId,
        dbId: existing ? existing.dbId || null : null,
        fieldType: type,
        label: existing ? existing.label : typeLabels[type],
        placeholder: existing ? existing.placeholder || '' : '',
        isRequired: existing ? existing.isRequired : false,
        options: existing ? (existing.options || []) : (type === 'select' || type === 'radio' ? ['Možnost 1'] : (type === 'image' ? { width: 100, align: 'center'} : [])),
        conditions: existing ? existing.conditions || null : null,
        systemKey: existing ? existing.systemKey || null : null
    };

    state.fields.push(field);
    renderFieldCard(field);
    updateEmptyState();
}

// ===== Render field card =====
function renderFieldCard(field) {
    var canvas = document.getElementById('field-canvas');
    var card = document.createElement('div');
    card.className = 'fb-field-card';
    card.dataset.localId = field.localId;
    card.draggable = true;

    var isDisplay = displayOnlyTypes.indexOf(field.fieldType) !== -1;
    var hasOptions = field.fieldType === 'select' || field.fieldType === 'radio';
    var conditionHtml = buildConditionHtml(field);
    var optionsHtml = hasOptions ? buildOptionsHtml(field) : '';

    // Body content differs for display-only types
    var bodyHtml = '';
    if (field.fieldType === 'info') {
        bodyHtml = '' +
            '<div class="fb-field-row">' +
                '<div class="fb-field-group" style="flex: 1;">' +
                    '<label class="fb-label">Nadpis</label>' +
                    '<input type="text" class="profile-form-input fb-input-label" value="' + escHtml(field.label) + '" onchange="updateField(\'' + field.localId + '\', \'label\', this.value)">' +
                '</div>' +
            '</div>' +
            '<div class="fb-field-row">' +
                '<div class="fb-field-group" style="flex: 1;">' +
                    '<label class="fb-label">Text popisku</label>' +
                    '<textarea class="profile-form-input" rows="3" placeholder="Text, který se zobrazí ve formuláři..." onchange="updateField(\'' + field.localId + '\', \'placeholder\', this.value)">' + escHtml(field.placeholder) + '</textarea>' +
                '</div>' +
            '</div>';
    } else if (field.fieldType === 'image') {
        var imgOpts = field.options && typeof field.options === 'object' && !Array.isArray(field.options) ? field.options : { width: 100, align: 'center'};
        field.options = imgOpts;
        bodyHtml = '' +
            '<div class="fb-field-row">' +
                '<div class="fb-field-group" style="flex: 1;">' +
                    '<label class="fb-label">Popisek obrázku</label>' +
                    '<input type="text" class="profile-form-input fb-input-label" value="' + escHtml(field.label) + '" onchange="updateField(\'' + field.localId + '\', \'label\', this.value)">' +
                '</div>' +
            '</div>' +
            '<div class="fb-field-row">' +
                '<div class="fb-field-group" style="flex: 1;">' +
                    '<label class="fb-label">URL obrázku</label>' +
                    '<input type="url" class="profile-form-input fb-image-url" value="' + escHtml(field.placeholder) + '" placeholder="https://example.com/obrazek.jpg nebo Google Disk: https://lh3.googleusercontent.com/d/FILE_ID" oninput="updateField(\'' + field.localId + '\', \'placeholder\', this.value); updateImagePreview(\'' + field.localId + '\', this.value)">' +
                '</div>' +
            '</div>' +
            '<div class="fb-field-row" style="align-items: center;">' +
                '<div class="fb-field-group" style="flex: 2;">' +
                    '<label class="fb-label">Šířka: <span id="width-val-' + field.localId + '">' + imgOpts.width + '</span>%</label>' +
                    '<input type="range" min="20" max="100" step="5" value="' + imgOpts.width + '" class="fb-range" oninput="updateImageOption(\'' + field.localId + '\', \'width\', this.value)">' +
                '</div>' +
                '<div class="fb-field-group" style="flex: 1;">' +
                    '<label class="fb-label">Zarovnání</label>' +
                    '<div class="fb-align-btns">' +
                        '<button type="button" class="fb-align-btn' + (imgOpts.align === 'left' ? ' active' : '') + '" onclick="updateImageOption(\'' + field.localId + '\', \'align\', \'left\')" title="Vlevo">' +
                            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 10H3M21 6H3M21 14H3M17 18H3"/></svg>' +
                        '</button>' +
                        '<button type="button" class="fb-align-btn' + (imgOpts.align === 'center' ? ' active' : '') + '" onclick="updateImageOption(\'' + field.localId + '\', \'align\', \'center\')" title="Na střed">' +
                            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10H6M21 6H3M21 14H3M18 18H6"/></svg>' +
                        '</button>' +
                        '<button type="button" class="fb-align-btn' + (imgOpts.align === 'right' ? ' active' : '') + '" onclick="updateImageOption(\'' + field.localId + '\', \'align\', \'right\')" title="Vpravo">' +
                            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10H7M21 6H3M21 14H3M21 18H7"/></svg>' +
                        '</button>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="fb-image-preview" id="preview-' + field.localId + '" style="text-align:' + imgOpts.align + ';">' +
                (field.placeholder ? '<img src="' + escHtml(field.placeholder) + '" alt="Náhled" style="max-width:' + imgOpts.width + '%;">' : '<span>Náhled se zobrazí po zadání URL</span>') +
            '</div>';
    } else if (field.fieldType === 'youtube') {
        var embedUrl = getYoutubeEmbedUrl(field.placeholder);
        bodyHtml = '' +
            '<div class="fb-field-row">' +
                '<div class="fb-field-group" style="flex: 1;">' +
                    '<label class="fb-label">Popisek videa</label>' +
                    '<input type="text" class="profile-form-input fb-input-label" value="' + escHtml(field.label) + '" onchange="updateField(\'' + field.localId + '\', \'label\', this.value)">' +
                '</div>' +
            '</div>' +
            '<div class="fb-field-row">' +
                '<div class="fb-field-group" style="flex: 1;">' +
                    '<label class="fb-label">YouTube URL</label>' +
                    '<input type="url" class="profile-form-input fb-youtube-url" value="' + escHtml(field.placeholder) + '" placeholder="https://www.youtube.com/watch?v=..." oninput="updateField(\'' + field.localId + '\', \'placeholder\', this.value); updateYoutubePreview(\'' + field.localId + '\', this.value)">' +
                '</div>' +
            '</div>' +
            '<div class="fb-youtube-preview" id="preview-' + field.localId + '">' +
                (embedUrl ? '<iframe src="' + embedUrl + '" frameborder="0" allowfullscreen></iframe>' : '<span>Náhled se zobrazí po zadání URL</span>') +
            '</div>';
    } else {
        // Standard input field
        bodyHtml = '' +
            '<div class="fb-field-row">' +
                '<div class="fb-field-group" style="flex: 2;">' +
                    '<label class="fb-label">Popisek *</label>' +
                    '<input type="text" class="profile-form-input fb-input-label" value="' + escHtml(field.label) + '" onchange="updateField(\'' + field.localId + '\', \'label\', this.value)">' +
                '</div>' +
                '<div class="fb-field-group" style="flex: 1;">' +
                    '<label class="fb-label">Placeholder</label>' +
                    '<input type="text" class="profile-form-input" value="' + escHtml(field.placeholder) + '" placeholder="Nápověda..." onchange="updateField(\'' + field.localId + '\', \'placeholder\', this.value)">' +
                '</div>' +
            '</div>' +
            '<div class="fb-field-row" style="align-items: center;">' +
                '<label class="auth-checkbox-label" style="margin: 0;">' +
                    '<input type="checkbox" class="auth-checkbox" ' + (field.isRequired ? 'checked' : '') + ' onchange="updateField(\'' + field.localId + '\', \'isRequired\', this.checked)">' +
                    '<span>Povinné pole</span>' +
                '</label>' +
                '<label class="auth-checkbox-label" style="margin: 0;">' +
                    '<input type="checkbox" class="auth-checkbox fb-condition-toggle" ' + (field.conditions ? 'checked' : '') + ' onchange="toggleCondition(\'' + field.localId + '\', this.checked)">' +
                    '<span class="fb-tooltip-wrapper">Podmínka zobrazení <span class="fb-tooltip-icon" data-tooltip="Pole se ve formuláři zobrazí pouze tehdy, když jiné pole splní zvolenou podmínku. Např. zobrazit pole &quot;Jiné&quot; jen pokud uživatel vybere možnost &quot;Jiné&quot; v předchozím výběru.">?</span></span>' +
                '</label>' +
            '</div>' +
            optionsHtml;
    }

    // Display-only types: only condition toggle (no required, no placeholder/options)
    if (isDisplay) {
        bodyHtml += '' +
            '<div class="fb-field-row" style="align-items: center;">' +
                '<label class="auth-checkbox-label" style="margin: 0;">' +
                    '<input type="checkbox" class="auth-checkbox fb-condition-toggle" ' + (field.conditions ? 'checked' : '') + ' onchange="toggleCondition(\'' + field.localId + '\', this.checked)">' +
                    '<span class="fb-tooltip-wrapper">Podmínka zobrazení <span class="fb-tooltip-icon" data-tooltip="Pole se ve formuláři zobrazí pouze tehdy, když jiné pole splní zvolenou podmínku. Např. zobrazit pole &quot;Jiné&quot; jen pokud uživatel vybere možnost &quot;Jiné&quot; v předchozím výběru.">?</span></span>' +
                '</label>' +
            '</div>';
    }

    var profileBadge = field.systemKey ? '<span class="fb-profile-badge" title="Předvyplní se z profilu uživatele">Profil</span>' : '';

    card.innerHTML = '' +
        '<div class="fb-field-header">' +
            '<div class="fb-drag-handle" title="Přetáhněte pro změnu pořadí">' +
                '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/></svg>' +
            '</div>' +
            '<div class="fb-field-type-info">' +
                '<span class="fb-field-type-badge">' + typeLabels[field.fieldType] + '</span>' +
                profileBadge +
                '<span class="fb-field-type-desc">' + (typeDescriptions[field.fieldType] || '') + '</span>' +
            '</div>' +
            '<button type="button" class="fb-field-delete" onclick="removeField(\'' + field.localId + '\')" title="Odstranit pole">' +
                '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>' +
            '</button>' +
        '</div>' +
        '<div class="fb-field-body">' +
            bodyHtml +
            '<div class="fb-condition-area" id="condition-' + field.localId + '" style="' + (field.conditions ? '' : 'display:none;') + '">' +
                conditionHtml +
            '</div>' +
        '</div>';

    canvas.appendChild(card);
    initDragEvents(card);
    styleSelectsInElement(card);

    // Initialize preview for existing data
    if (field.fieldType === 'youtube' && field.placeholder) {
        updateYoutubePreview(field.localId, field.placeholder);
    }
    if (field.fieldType === 'image' && field.placeholder) {
        updateImagePreview(field.localId, field.placeholder);
    }
}

// ===== Options editor =====
function buildOptionsHtml(field) {
    var html = '<div class="fb-options-area" id="options-' + field.localId + '">' +
        '<label class="fb-label">Možnosti</label>';
    field.options.forEach(function(opt, i) {
        html += '<div class="fb-option-row">' +
            '<input type="text" class="profile-form-input" value="' + escHtml(opt) + '" onchange="updateOption(\'' + field.localId + '\', ' + i + ', this.value)" style="flex: 1;">' +
            '<button type="button" class="fb-option-remove" onclick="removeOption(\'' + field.localId + '\', ' + i + ')" title="Odstranit">' +
                '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>' +
            '</button>' +
        '</div>';
    });
    html += '<button type="button" class="fb-option-add" onclick="addOption(\'' + field.localId + '\')">' +
        '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg> Přidat možnost' +
    '</button></div>';
    return html;
}

function addOption(localId) {
    var field = getField(localId);
    if (!field) return;
    field.options.push('Možnost ' + (field.options.length + 1));
    rerenderFieldOptions(localId);
}

function removeOption(localId, index) {
    var field = getField(localId);
    if (!field || field.options.length <= 1) return;
    field.options.splice(index, 1);
    rerenderFieldOptions(localId);
}

function updateOption(localId, index, value) {
    var field = getField(localId);
    if (!field) return;
    field.options[index] = value;
}

function rerenderFieldOptions(localId) {
    var area = document.getElementById('options-' + localId);
    if (!area) return;
    var field = getField(localId);
    area.outerHTML = buildOptionsHtml(field);
}

// ===== Conditions =====
function buildConditionHtml(field) {
    var otherFields = state.fields.filter(function(f) { return f.localId !== field.localId; });
    if (otherFields.length === 0) {
        return '<p class="fb-condition-note">Podmínky vyžadují alespoň 2 pole ve formuláři.</p>';
    }

    var cond = field.conditions && field.conditions.rules && field.conditions.rules[0] ? field.conditions.rules[0] : {};
    var selectedField = cond.fieldLocalId || '';
    var selectedOp = cond.operator || 'equals';
    var selectedVal = cond.value || '';

    // Build hidden selects (for value tracking) + will be styled after insert
    var html = '<div class="fb-condition-row">' +
        '<div class="fb-field-group">' +
            '<label class="fb-label">Zobrazit, když pole:</label>' +
            '<select class="profile-form-input fb-styled-select" data-onchange="updateConditionField" data-field-id="' + field.localId + '">';
    html += '<option value="">-- Vyberte pole --</option>';
    otherFields.forEach(function(f) {
        html += '<option value="' + f.localId + '" ' + (selectedField === f.localId ? 'selected' : '') + '>' + escHtml(f.label) + '</option>';
    });
    html += '</select></div>' +
        '<div class="fb-field-group">' +
            '<label class="fb-label">Operátor:</label>' +
            '<select class="profile-form-input fb-styled-select" data-onchange="updateConditionOp" data-field-id="' + field.localId + '">' +
                '<option value="equals"' + (selectedOp === 'equals' ? ' selected' : '') + '>rovná se</option>' +
                '<option value="not_equals"' + (selectedOp === 'not_equals' ? ' selected' : '') + '>nerovná se</option>' +
                '<option value="contains"' + (selectedOp === 'contains' ? ' selected' : '') + '>obsahuje</option>' +
                '<option value="not_empty"' + (selectedOp === 'not_empty' ? ' selected' : '') + '>není prázdné</option>' +
                '<option value="empty"' + (selectedOp === 'empty' ? ' selected' : '') + '>je prázdné</option>' +
            '</select>' +
        '</div>' +
        '<div class="fb-field-group" id="condition-value-' + field.localId + '" ' + (selectedOp === 'not_empty' || selectedOp === 'empty' ? 'style="display:none;"' : '') + '>' +
            '<label class="fb-label">Hodnota:</label>' +
            '<input type="text" class="profile-form-input" value="' + escHtml(selectedVal) + '" onchange="updateConditionVal(\'' + field.localId + '\', this.value)">' +
        '</div>' +
    '</div>';
    return html;
}

// ===== Styled selects (uses global initStyledSelects) =====
function styleSelectsInElement(container) {
    initStyledSelects(container, { selector: 'select.fb-styled-select' });
}

function toggleCondition(localId, enabled) {
    var area = document.getElementById('condition-' + localId);
    var field = getField(localId);
    if (!field) return;

    if (enabled) {
        field.conditions = { logic: 'AND', rules: [{ fieldLocalId: '', operator: 'equals', value: '' }] };
        area.innerHTML = buildConditionHtml(field);
        area.style.display = '';
        styleSelectsInElement(area);
    } else {
        field.conditions = null;
        area.style.display = 'none';
    }
}

function updateConditionField(localId, value) {
    var field = getField(localId);
    if (!field || !field.conditions) return;
    field.conditions.rules[0].fieldLocalId = value;
}

function updateConditionOp(localId, value) {
    var field = getField(localId);
    if (!field || !field.conditions) return;
    field.conditions.rules[0].operator = value;
    var valGroup = document.getElementById('condition-value-' + localId);
    if (valGroup) {
        valGroup.style.display = (value === 'not_empty' || value === 'empty') ? 'none' : '';
    }
}

function updateConditionVal(localId, value) {
    var field = getField(localId);
    if (!field || !field.conditions) return;
    field.conditions.rules[0].value = value;
}

// ===== Field operations =====
function getField(localId) {
    return state.fields.find(function(f) { return f.localId === localId; });
}

function updateField(localId, prop, value) {
    var field = getField(localId);
    if (field) field[prop] = value;
}

function removeField(localId) {
    state.fields = state.fields.filter(function(f) { return f.localId !== localId; });
    var card = document.querySelector('.fb-field-card[data-local-id="' + localId + '"]');
    if (card) card.remove();
    updateEmptyState();
    refreshProfilePalette();
}

function updateEmptyState() {
    var empty = document.getElementById('canvas-empty');
    if (empty) {
        empty.style.display = state.fields.length === 0 ? 'flex' : 'none';
    }
}

// ===== Drag & Drop =====
var draggedCard = null;

function initDragEvents(card) {
    card.addEventListener('dragstart', function(e) {
        draggedCard = card;
        card.classList.add('fb-dragging');
        e.dataTransfer.effectAllowed = 'move';
    });

    card.addEventListener('dragend', function() {
        card.classList.remove('fb-dragging');
        draggedCard = null;
        syncOrderFromDom();
    });

    card.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        if (!draggedCard || draggedCard === card) return;
        var rect = card.getBoundingClientRect();
        var midY = rect.top + rect.height / 2;
        if (e.clientY < midY) {
            card.parentNode.insertBefore(draggedCard, card);
        } else {
            card.parentNode.insertBefore(draggedCard, card.nextSibling);
        }
    });
}

function syncOrderFromDom() {
    var cards = document.querySelectorAll('.fb-field-card');
    var newOrder = [];
    cards.forEach(function(card) {
        var localId = card.dataset.localId;
        var field = getField(localId);
        if (field) newOrder.push(field);
    });
    state.fields = newOrder;
}

// ===== Save =====
function saveTemplate() {
    var btn = document.getElementById('save-btn');
    var status = document.getElementById('save-status');

    // Sync metadata
    state.name = document.getElementById('template-name').value.trim();
    state.description = document.getElementById('template-description').value.trim();

    // Resolve conditions: nahrad fieldLocalId za dbId nebo index
    var payload = {
        id: state.id,
        name: state.name,
        description: state.description,
        fields: state.fields.map(function(f, idx) {
            var cond = null;
            if (f.conditions && f.conditions.rules && f.conditions.rules[0] && f.conditions.rules[0].fieldLocalId) {
                var parentField = getField(f.conditions.rules[0].fieldLocalId);
                cond = {
                    logic: 'AND',
                    rules: [{
                        field_index: state.fields.indexOf(parentField),
                        operator: f.conditions.rules[0].operator,
                        value: f.conditions.rules[0].value || ''
                    }]
                };
            }
            return {
                dbId: f.dbId,
                fieldType: f.fieldType,
                label: f.label,
                placeholder: f.placeholder,
                isRequired: f.isRequired,
                options: f.options,
                conditions: cond,
                systemKey: f.systemKey || null
            };
        })
    };

    btn.disabled = true;
    btn.textContent = 'Ukládám...';
    status.style.display = 'none';

    fetch(saveUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        btn.disabled = false;
        btn.textContent = 'Uložit šablonu';

        if (data.success) {
            state.id = data.templateId;
            status.textContent = 'Šablona byla uložena.';
            status.style.color = '#22c55e';
            status.style.display = 'block';
            if (typeof showToast === 'function') showToast('Šablona byla uložena.', 'success');
            // Redirect po 1s
            setTimeout(function() {
                window.location.href = listUrl;
            }, 1000);
        } else {
            status.innerHTML = (data.errors || ['Neznámá chyba.']).join('<br>');
            status.style.color = '#ef4444';
            status.style.display = 'block';
        }
    })
    .catch(function() {
        btn.disabled = false;
        btn.textContent = 'Uložit šablonu';
        status.textContent = 'Chyba při odesílání.';
        status.style.color = '#ef4444';
        status.style.display = 'block';
    });
}

// ===== Image options =====
function updateImageOption(localId, key, value) {
    var field = getField(localId);
    if (!field) return;
    if (typeof field.options !== 'object' || Array.isArray(field.options)) field.options = { width: 100, align: 'center'};
    field.options[key] = key === 'width' ? parseInt(value) : value;

    var preview = document.getElementById('preview-' + localId);
    if (preview) {
        var img = preview.querySelector('img');
        if (key === 'width') {
            document.getElementById('width-val-' + localId).textContent = value;
            if (img) img.style.maxWidth = value + '%';
        }
        if (key === 'align') {
            preview.style.textAlign = value;
            // Update active button
            var card = document.querySelector('.fb-field-card[data-local-id="' + localId + '"]');
            if (card) {
                card.querySelectorAll('.fb-align-btn').forEach(function(btn) { btn.classList.remove('active'); });
                card.querySelector('.fb-align-btn[title="' + (value === 'left' ? 'Vlevo' : value === 'center' ? 'Na střed' : 'Vpravo') + '"]').classList.add('active');
            }
        }
    }
}

// ===== Image & YouTube preview helpers =====
function updateImagePreview(localId, url) {
    var preview = document.getElementById('preview-' + localId);
    if (!preview) return;
    if (url && (url.match(/^https?:\/\/.+\.(jpg|jpeg|png|gif|webp|svg)(\?.*)?$/i) || url.match(/^https?:\/\//))) {
        preview.innerHTML = '<img src="' + escHtml(url) + '" alt="Náhled" onerror="this.parentNode.innerHTML=\'<span>Obrázek nelze načíst</span>\'">';
    } else {
        preview.innerHTML = '<span>Náhled se zobrazí po zadání URL</span>';
    }
}

function getYoutubeEmbedUrl(url) {
    if (!url) return '';
    var match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]+)/);
    return match ? 'https://www.youtube.com/embed/' + match[1] : '';
}

function updateYoutubePreview(localId, url) {
    var preview = document.getElementById('preview-' + localId);
    if (!preview) return;
    var embedUrl = getYoutubeEmbedUrl(url);
    if (embedUrl) {
        preview.style.display = 'block';
        preview.style.position = 'relative';
        preview.style.paddingBottom = '56.25%';
        preview.style.height = '0';
        preview.style.overflow = 'hidden';
        preview.innerHTML = '<iframe src="' + embedUrl + '" frameborder="0" allowfullscreen></iframe>';
    } else {
        preview.style.display = 'flex';
        preview.style.position = '';
        preview.style.paddingBottom = '';
        preview.style.height = '';
        preview.style.overflow = '';
        preview.innerHTML = '<span>Zadejte platnou YouTube URL</span>';
    }
}

// ===== Helpers =====
function escHtml(str) {
    var div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
}
</script>

{/block}
