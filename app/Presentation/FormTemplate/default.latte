{block content}

<section class="admin-section">
    <div class="admin-container">
        {* Header *}
        <div class="admin-header scroll-reveal">
            <div class="admin-header-content">
                <h1 class="admin-title font-display">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Šablony formulářů
                </h1>
                <button type="button" class="admin-action-btn admin-action-btn-success" onclick="document.getElementById('preset-modal').style.display='flex'">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Nová šablona
                </button>
            </div>
        </div>

        {* Templates list *}
        <div class="profile-card scroll-reveal">
            <div class="profile-card-body" style="padding: 0;">
                {if empty($templates)}
                    <div style="padding: 40px 20px; text-align: center; color: var(--text-gray);">
                        <svg style="width: 48px; height: 48px; margin: 0 auto 12px; opacity: 0.4;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        <p style="font-weight: 600; margin-bottom: 4px;">Žádné šablony</p>
                        <p style="font-size: 0.85rem;">Vytvořte první šablonu formuláře pro registrace na akce.</p>
                    </div>
                {else}
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Název</th>
                                    <th>Popis</th>
                                    <th>Polí</th>
                                    <th>Akcí</th>
                                    <th>Vytvořeno</th>
                                    <th>Akce</th>
                                </tr>
                            </thead>
                            <tbody>
                                {foreach $templates as $item}
                                    <tr>
                                        <td data-label="Název">
                                            <strong>{$item['template']->name}</strong>
                                            {if !$item['isOwn']}
                                                <span class="reg-status-badge reg-status-waitlist" style="margin-left: 6px; font-size: 0.65rem;">Sdílená</span>
                                            {/if}
                                        </td>
                                        <td data-label="Popis">
                                            <span style="color: var(--text-gray); font-size: 0.85rem;">
                                                {$item['template']->description|truncate:60 ?? '---'}
                                            </span>
                                        </td>
                                        <td data-label="Polí">
                                            <span class="admin-status admin-status-active">{$item['fieldCount']}</span>
                                        </td>
                                        <td data-label="Akcí">
                                            {$item['eventCount']}
                                        </td>
                                        <td data-label="Vytvořeno">
                                            {$item['template']->created_at|date:'j. n. Y'}
                                        </td>
                                        <td data-label="Akce">
                                            <div class="admin-actions">
                                                {if $item['isOwn']}
                                                    <a n:href="FormTemplate:builder, id => $item['template']->id" class="admin-detail-btn" title="Upravit">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                        </svg>
                                                    </a>
                                                    {if $item['eventCount'] === 0}
                                                        <a n:href="deleteTemplate!, id => $item['template']->id"
                                                           class="admin-toggle-btn admin-btn-deactivate"
                                                           onclick="return confirm('Opravdu smazat šablonu \'{$item['template']->name}\'?')"
                                                           title="Smazat">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                            </svg>
                                                        </a>
                                                    {/if}
                                                {else}
                                                    <a n:href="FormTemplate:builder, id => $item['template']->id" class="admin-detail-btn" title="Vytvořit kopii">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                                        </svg>
                                                    </a>
                                                {/if}
                                            </div>
                                        </td>
                                    </tr>
                                {/foreach}
                            </tbody>
                        </table>
                    </div>
                {/if}
            </div>
        </div>
    </div>
</section>

{* Preset selection modal *}
<div id="preset-modal" class="preset-modal-overlay" style="display: none;" onclick="if(event.target===this)this.style.display='none'">
    <div class="preset-modal">
        <h2 class="preset-modal-title font-display">Vyberte typ šablony</h2>
        <p class="preset-modal-desc">Zvolte předpřipravenou šablonu nebo začněte od nuly.</p>

        <div class="preset-cards">
            <a href="{link FormTemplate:builder, preset => 'empty'}" class="preset-card">
                <div class="preset-card-icon" style="background: linear-gradient(135deg, #64748b, #475569);">
                    <svg class="w-8 h-8" fill="none" stroke="white" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <h3>Prázdná</h3>
                <p>Pouze základní údaje, vlastní pole si přidáte sami.</p>
            </a>

            <a href="{link FormTemplate:builder, preset => 'vikendovka'}" class="preset-card">
                <div class="preset-card-icon" style="background: linear-gradient(135deg, #0075b5, #005a8c);">
                    <svg class="w-8 h-8" fill="none" stroke="white" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                </div>
                <h3>Víkendovka</h3>
                <p>Vegetarián, alergie, léky, zdravotní požadavky, umí plavat.</p>
            </a>

            <a href="{link FormTemplate:builder, preset => 'tabor'}" class="preset-card">
                <div class="preset-card-icon" style="background: linear-gradient(135deg, #009043, #006d32);">
                    <svg class="w-8 h-8" fill="none" stroke="white" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                    </svg>
                </div>
                <h3>Tábor</h3>
                <p>Vegetarián, stravovací návyky, alergie, léky, zdravotní požadavky, umí plavat, velikost oblečení.</p>
            </a>
        </div>

        <button type="button" class="preset-modal-close" onclick="document.getElementById('preset-modal').style.display='none'">Zrušit</button>
    </div>
</div>

{/block}
