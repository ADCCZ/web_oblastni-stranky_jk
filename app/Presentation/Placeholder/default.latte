{block content}

<section class="placeholder-page-section">
    <div class="placeholder-page-container">
        <div class="placeholder-hammer-scene" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="placeholder-hammer-svg">
                <defs>
                    <linearGradient id="ph-wood-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#cf9f60"/>
                        <stop offset="55%" stop-color="#b5834a"/>
                        <stop offset="100%" stop-color="#8a5f30"/>
                    </linearGradient>
                    <linearGradient id="ph-handle-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#c99a6b"/>
                        <stop offset="50%" stop-color="#a67c52"/>
                        <stop offset="100%" stop-color="#805f3d"/>
                    </linearGradient>
                    <linearGradient id="ph-metal-grad" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#a3b1c6"/>
                        <stop offset="45%" stop-color="#64748b"/>
                        <stop offset="100%" stop-color="#3f4b5c"/>
                    </linearGradient>
                    <linearGradient id="ph-nail-grad" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#d5dce4"/>
                        <stop offset="50%" stop-color="#94a3b8"/>
                        <stop offset="100%" stop-color="#5c6b7d"/>
                    </linearGradient>
                </defs>
                <rect x="97" y="148" width="6" height="24" rx="1" class="placeholder-nail-shaft"/>
                <rect x="50" y="160" width="100" height="22" rx="3" class="placeholder-wood"/>
                <g class="placeholder-wood-grain">
                    <path d="M 58 166 Q 100 164 145 167"/>
                    <path d="M 55 174 Q 100 176 148 173"/>
                    <path d="M 60 180 Q 105 178 142 181"/>
                </g>
                <ellipse cx="100" cy="148" rx="8" ry="4" class="placeholder-nail"/>
                <ellipse cx="97" cy="146.5" rx="2.2" ry="1.1" class="placeholder-nail-shine"/>
                <g class="placeholder-hammer-group">
                    <rect x="14" y="110" width="85" height="12" rx="5" class="placeholder-hammer-handle"/>
                    <line x1="16" y1="116" x2="97" y2="116" class="placeholder-handle-grain"/>
                    <rect x="86" y="84" width="28" height="64" rx="7" class="placeholder-hammer-head"/>
                    <rect x="86" y="84" width="10" height="64" rx="5" class="placeholder-hammer-head-highlight"/>
                </g>
                <g class="placeholder-impact">
                    <g class="spark-variant spark-variant-1">
                        <path d="M97 146 Q94 148 91 145" class="spark spark-a"/>
                        <path d="M102 147 Q103 138 99 128" class="spark spark-b"/>
                        <path d="M104 149 Q110 147 115 143" class="spark spark-c"/>
                        <path d="M99 145 Q102 147 105 145" class="spark spark-d"/>
                        <path d="M96 150 Q90 142 87 135" class="spark spark-e"/>
                        <circle cx="106" cy="138" r="1"   class="spark-ember spark-ember-a"/>
                        <circle cx="93" cy="136" r="0.9" class="spark-ember spark-ember-b"/>
                        <circle cx="110" cy="146" r="0.9" class="spark-ember spark-ember-c"/>
                    </g>
                    <g class="spark-variant spark-variant-2">
                        <path d="M100 147 Q92 146 85 148" class="spark spark-f"/>
                        <path d="M101 146 Q104 138 107 130" class="spark spark-g"/>
                        <path d="M99 149 Q106 152 113 151" class="spark spark-h"/>
                        <path d="M102 145 Q98 138 95 132" class="spark spark-i"/>
                        <circle cx="90" cy="140" r="0.9" class="spark-ember spark-ember-d"/>
                        <circle cx="108" cy="143" r="1"   class="spark-ember spark-ember-e"/>
                    </g>
                    <g class="spark-variant spark-variant-3">
                        <path d="M98 146 Q93 143 89 139" class="spark spark-j"/>
                        <path d="M101 145 Q106 140 111 136" class="spark spark-k"/>
                        <path d="M99 147 Q96 138 94 130" class="spark spark-l"/>
                        <path d="M102 146 Q107 141 112 135" class="spark spark-m"/>
                        <path d="M97 148 Q90 145 84 143" class="spark spark-n"/>
                        <path d="M103 147 Q110 145 116 142" class="spark spark-o"/>
                        <circle cx="105" cy="132" r="1"   class="spark-ember spark-ember-f"/>
                        <circle cx="91" cy="135" r="0.9" class="spark-ember spark-ember-g"/>
                    </g>
                </g>
            </svg>
        </div>

        <p class="placeholder-eyebrow">PŘIPRAVUJEME</p>
        <h1 n:block=title class="placeholder-title font-display">{$pageTitle} se ještě staví</h1>
        <p class="placeholder-subtitle">Na téhle části webu právě pracujeme. Zkuste se prosím vrátit později.</p>

        <a n:href="Home:default" class="placeholder-home-link">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Zpět na hlavní stránku
        </a>
    </div>
</section>

<style>
    .placeholder-page-section {
        position: relative;
        z-index: 10;
        padding-top: var(--page-content-top);
        padding-bottom: var(--page-content-top);
        min-height: 100vh;
        box-sizing: border-box;
        display: flex;
        align-items: center;
    }

    .placeholder-page-container {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 clamp(16px, 4vw, 32px);
        text-align: center;
    }

    .placeholder-hammer-scene {
        width: clamp(200px, 32vw, 320px);
        margin: 0 auto clamp(16px, 3vw, 32px);
    }

    .placeholder-hammer-svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .placeholder-wood {
        fill: url(#ph-wood-grad);
        stroke: #7a5228;
        stroke-width: 2;
    }

    .dark .placeholder-wood {
        fill: #8a5f30;
        stroke: #6b4823;
    }

    /* Kresba let dřeva uvnitř prkna - jemné, poloprůhledné, mírně zvlněné
       čáry, aby to nebyla jen plochá barva. */
    .placeholder-wood-grain path {
        fill: none;
        stroke: #6b4419;
        stroke-width: 1;
        opacity: 0.3;
    }

    .dark .placeholder-wood-grain path {
        stroke: #3d2a13;
        opacity: 0.4;
    }

    .placeholder-nail-shine {
        fill: #ffffff;
        opacity: 0.55;
    }

    .dark .placeholder-nail-shine {
        opacity: 0.35;
    }

    /* Osa otáčení je ukotvená přesně na konci rukojeti (její horní hrana,
       střed x) - "rect x=120 y=4 width=12" u .placeholder-hammer-handle
       níž → konec rukojeti = (120+12/2, 4) = (126, 4). Kladivo (rukojeť+
       hlava jako g.placeholder-hammer-group) se otáčí kolem tohohle bodu;
       pozici/posun (kam se má kladivo v klidu/na konci švihu vykreslit)
       lze měnit úpravou x/y u handle+head+head-highlight rectů výš, beze
       změny téhle osy. */
    .placeholder-hammer-group {
        transform-origin: 14px 116px;
        animation: hammerSwing 1.4s ease-in-out infinite;
    }

    .placeholder-hammer-handle {
        fill: url(#ph-handle-grad);
        stroke: #6b4a2e;
        stroke-width: 1;
    }

    .placeholder-handle-grain {
        stroke: #6b4a2e;
        stroke-width: 1;
        opacity: 0.3;
    }

    .placeholder-hammer-head {
        fill: url(#ph-metal-grad);
        stroke: #2c3644;
        stroke-width: 1;
    }

    .placeholder-hammer-head-highlight {
        fill: #b8c4d6;
        opacity: 0.6;
    }

    .dark .placeholder-hammer-handle {
        fill: #b8916a;
        stroke: #4a3319;
    }

    .dark .placeholder-handle-grain {
        stroke: #4a3319;
        opacity: 0.4;
    }

    /* Časování podle skutečného mlácení: rychlý úder dolů (zrychlení paže +
       zápěstí), pak pomalejší, kontrolované zvednutí zpět - ne stejně
       rychlé oběma směry, jak to bylo dřív. */
    @keyframes hammerSwing {
        0%   { transform: rotate(-90deg); }
        38%  { transform: rotate(-90deg); }
        46%  { transform: rotate(0deg); }
        50%  { transform: rotate(0deg); }
        100% { transform: rotate(-90deg); }
    }

    .placeholder-nail,
    .placeholder-nail-shaft {
        fill: url(#ph-nail-grad);
        stroke: #45505e;
        stroke-width: 0.75;
    }

    .dark .placeholder-nail,
    .dark .placeholder-nail-shaft {
        fill: #cbd5e1;
        stroke: none;
    }

    /* Jiskry - každá s vlastní animací (ne jedna sdílená na celé skupině),
       aby nebyly dokonale synchronní/symetrické jako skutečný odlétávající
       odprysk kovu. Nepravidelnost v několika směrech současně:
       - dráha je mírně zakřivená (SVG "path" s Q-křivkou, ne rovná čára) -
         napodobuje, jak gravitace/odpor vzduchu ohýbá let jiskry
       - barva chladne od žhavě bílé/žluté (u dopadu) k oranžové (na konci)
         u některých kousků - realistický "hot to cool" přechod
       - jemná záře kolem každé čáry (drop-shadow), ne ostrá plná barva
       - délka/úhel dráhy (viz "d" atribut v HTML výš)
       - tloušťka (stroke-width)
       - časování (animation-delay, i záporné - "začni o kousek dál v cyklu")
       - velikost při odletu (--peak/--end - jak moc se ta čára zvětší;
         value se použije v @keyframes přes var(), takže každá jiskra může
         "vystřelit" jinak daleko/rychle, i když sdílí stejnou křivku).
       Společný "transform-origin" (bod dopadu) zůstává stejný pro všechny,
       ať se škálují od stejného místa (kde kladivo skutečně udeří). */
    .spark {
        fill: none;
        stroke: #ffd600;
        stroke-linecap: round;
        opacity: 0;
        transform-origin: 100px 148px;
        animation: sparkFly 1.4s ease-in-out infinite;
    }

    .spark-a { stroke-width: 1.4; stroke: #fffde7; filter: drop-shadow(0 0 1px #fff59d); animation-delay: 0s;      --peak: 0.8;  --end: 1.2; }
    .spark-b { stroke-width: 1.3; stroke: #fff59d; filter: drop-shadow(0 0 1px #ffe27a); animation-delay: 0.02s;   --peak: 0.9;  --end: 1.35; }
    .spark-c { stroke-width: 1.6; stroke: #fffde7; filter: drop-shadow(0 0 1px #fff59d); animation-delay: -0.015s; --peak: 0.75; --end: 1.15; }
    .spark-d { stroke-width: 1.2; stroke: #fff59d; filter: drop-shadow(0 0 1px #ffe27a); animation-delay: 0.04s;   --peak: 0.85; --end: 1.3; }
    .spark-e { stroke-width: 1.5; stroke: #fffde7; filter: drop-shadow(0 0 1px #fff59d); animation-delay: -0.03s;  --peak: 0.7;  --end: 1.1; }

    @keyframes sparkFly {
        0%, 43%   { opacity: 0; transform: scale(0.25); }
        46%       { opacity: 1; transform: scale(var(--peak, 1)); }
        47.5%     { opacity: 1; transform: scale(calc(var(--peak, 1) * 1.15)); }
        61%       { opacity: 0; transform: scale(var(--end, 1.8)); }
        100%      { opacity: 0; transform: scale(var(--end, 1.8)); }
    }

    /* Drobné odletující "kousky" (embery) - malé tečky rozeseté mimo hlavní
       dráhy jisker, s vlastním (pomalejším) mizením, pro hustší rozstřik. */
    .spark-ember {
        fill: #ffcf40;
        opacity: 0;
        transform-origin: 100px 148px;
        animation: emberFly 1.4s ease-out infinite;
    }

    .spark-ember-a { fill: #fffde7; animation-delay: 0.01s; }
    .spark-ember-b { fill: #fff59d; animation-delay: -0.02s; }
    .spark-ember-c { fill: #fffde7; animation-delay: 0.03s; }

    @keyframes emberFly {
        0%, 44%  { opacity: 0; transform: scale(0.4); }
        47%      { opacity: 1; transform: scale(1); }
        70%      { opacity: 0.4; transform: scale(0.7); }
        100%     { opacity: 0; transform: scale(0.3); }
    }

    /* Varianta 2 - stejný "ping" charakter jako varianta 3 (drobné, husté,
       světlé), jen s trochu jinými úhly/zpožděním pro odlišení při střídání. */
    .spark-f { stroke-width: 1.3; stroke: #fffde7; filter: drop-shadow(0 0 1px #fff59d); animation-delay: 0s;      --peak: 0.8;  --end: 1.2; }
    .spark-g { stroke-width: 1.2; stroke: #fff59d; filter: drop-shadow(0 0 1px #ffe27a); animation-delay: 0.025s;  --peak: 0.9;  --end: 1.35; }
    .spark-h { stroke-width: 1.5; stroke: #fffde7; filter: drop-shadow(0 0 1px #fff59d); animation-delay: -0.02s; --peak: 0.75; --end: 1.15; }
    .spark-i { stroke-width: 1.2; stroke: #fff59d; filter: drop-shadow(0 0 1px #ffe27a); animation-delay: 0.04s;  --peak: 0.85; --end: 1.3; }
    .spark-ember-d { fill: #fffde7; animation-delay: 0.015s; }
    .spark-ember-e { fill: #fff59d; animation-delay: -0.01s; }

    /* Varianta 3 - hustší, ale drobnější a kratší "ping" jiskřičky, skoro
       bílé, těsně u sebe (menší rozptyl). */
    .spark-j { stroke-width: 1.4; stroke: #fffde7; filter: drop-shadow(0 0 1px #fff59d); animation-delay: 0s;      --peak: 0.8; --end: 1.2; }
    .spark-k { stroke-width: 1.2; stroke: #fff59d; filter: drop-shadow(0 0 1px #ffe27a); animation-delay: 0.015s;  --peak: 0.9; --end: 1.35; }
    .spark-l { stroke-width: 1.6; stroke: #fffde7; filter: drop-shadow(0 0 1px #fff59d); animation-delay: -0.01s; --peak: 0.75; --end: 1.15; }
    .spark-m { stroke-width: 1.3; stroke: #fff59d; filter: drop-shadow(0 0 1px #ffe27a); animation-delay: 0.03s;  --peak: 0.85; --end: 1.3; }
    .spark-n { stroke-width: 1.5; stroke: #fffde7; filter: drop-shadow(0 0 1px #fff59d); animation-delay: -0.025s; --peak: 0.8; --end: 1.2; }
    .spark-o { stroke-width: 1.2; stroke: #fff59d; filter: drop-shadow(0 0 1px #ffe27a); animation-delay: 0.02s;  --peak: 0.7; --end: 1.1; }
    .spark-ember-f { fill: #fffde7; animation-delay: 0.01s; }
    .spark-ember-g { fill: #fff59d; animation-delay: -0.015s; }

    /* "Brány" - povolí zobrazení dané varianty jen v její třetině 3-úderového
       cyklu (4.2s = 3× 1.4s dlouhý cyklus kladiva). Jednotlivé jiskry uvnitř
       (sparkFly/emberFly) dál běží na svém vlastním 1.4s cyklu beze změny -
       "brána" jen zakryje/odkryje, kdy je jejich záblesk vůbec vidět, takže
       se reálně střídá jiná varianta při každém dalším úderu kladiva. */
    .spark-variant {
        opacity: 0;
    }

    .spark-variant-1 { animation: sparkGate1 4.2s steps(1, end) infinite; }
    .spark-variant-2 { animation: sparkGate2 4.2s steps(1, end) infinite; }
    .spark-variant-3 { animation: sparkGate3 4.2s steps(1, end) infinite; }

    @keyframes sparkGate1 {
        0%      { opacity: 1; }
        33.33%  { opacity: 0; }
        100%    { opacity: 0; }
    }

    @keyframes sparkGate2 {
        0%      { opacity: 0; }
        33.34%  { opacity: 1; }
        66.66%  { opacity: 0; }
        100%    { opacity: 0; }
    }

    @keyframes sparkGate3 {
        0%      { opacity: 0; }
        66.67%  { opacity: 1; }
        100%    { opacity: 1; }
    }

    .placeholder-eyebrow {
        font-size: clamp(0.85rem, 1.2vw, 1rem);
        font-weight: 700;
        letter-spacing: 0.15em;
        color: var(--primary, #0075b5);
        margin-bottom: 12px;
    }

    .placeholder-title {
        font-size: clamp(1.8rem, 4.5vw, 2.75rem);
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 16px;
    }

    .placeholder-subtitle {
        color: var(--text-secondary);
        font-size: clamp(1rem, 1.8vw, 1.25rem);
        line-height: 1.6;
        margin-bottom: clamp(28px, 4vw, 40px);
    }

    .placeholder-home-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: clamp(12px, 1.6vw, 16px) clamp(28px, 3vw, 36px);
        background: linear-gradient(135deg, #0075b5 0%, #005a8c 100%);
        color: white;
        font-weight: 600;
        font-size: clamp(1rem, 1.4vw, 1.15rem);
        border-radius: 12px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(0, 117, 181, 0.3);
        transition: all 0.2s ease;
    }

    .placeholder-home-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 117, 181, 0.4);
    }
</style>
