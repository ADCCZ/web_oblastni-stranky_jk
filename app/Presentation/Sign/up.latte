{block content}
<div class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            {* Back to home *}
            <a n:href="Home:" class="auth-home-btn" title="Zpět na hlavní stránku">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
            </a>

            {* Header with logo *}
            <div class="auth-header">
                <div class="auth-logo">
                    <img src="{$basePath}/images/logo.png" alt="Jižní Kříž">
                </div>
                <h1 class="auth-title font-display">Registrace</h1>
                <p class="auth-subtitle">Připojte se k Jižnímu Kříži</p>
            </div>

            {* Registration Form *}
            {form signUpForm}
                {* Name fields *}
                <div class="auth-form-group">
                    <div class="auth-form-row">
                        <div>
                            <label class="auth-label" for="frm-signUpForm-first_name">Jméno</label>
                            <input n:name="first_name" class="auth-input" placeholder="Jan">
                        </div>
                        <div>
                            <label class="auth-label" for="frm-signUpForm-last_name">Příjmení</label>
                            <input n:name="last_name" class="auth-input" placeholder="Novák">
                        </div>
                    </div>
                </div>

                {* Email *}
                <div class="auth-form-group">
                    <label class="auth-label" for="frm-signUpForm-email">E-mail</label>
                    <input n:name="email" class="auth-input" placeholder="vas@email.cz">
                    <p id="email-status" class="auth-email-status" style="display: none;"></p>
                </div>

                {* Phone *}
                <div class="auth-form-group">
                    <label class="auth-label" for="frm-signUpForm-phone">
                        Telefon <span class="auth-label-optional">(nepovinné)</span>
                    </label>
                    <input n:name="phone" class="auth-input" placeholder="+420 123 456 789">
                </div>

                {* Role selection *}
                <div class="auth-form-group">
                    <label class="auth-label">Registruji se jako</label>
                    <div class="auth-role-select">
                        {foreach $form['role']->items as $value => $label}
                            <label class="auth-role-option">
                                <input type="radio" name="{$form['role']->getHtmlName()}" value="{$value}"
                                    {if $form['role']->value === $value}checked{/if}
                                    class="auth-role-radio">
                                <span class="auth-role-card">
                                    {if $value === 'member'}
                                        <svg class="auth-role-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                        </svg>
                                    {else}
                                        <svg class="auth-role-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                        </svg>
                                    {/if}
                                    <span class="auth-role-label">{$label}</span>
                                </span>
                            </label>
                        {/foreach}
                    </div>
                </div>

                {* Password *}
                <div class="auth-form-group">
                    <label class="auth-label" for="frm-signUpForm-password">Heslo</label>
                    <input n:name="password" class="auth-input" placeholder="Minimálně 8 znaků">
                    <div class="password-strength strength-0">
                        <div class="password-strength-bar"><div class="password-strength-fill"></div></div>
                        <div class="password-strength-text"><span class="password-strength-label"></span><span>min. 8 znaků</span></div>
                    </div>
                </div>

                {* Password Confirm *}
                <div class="auth-form-group">
                    <label class="auth-label" for="frm-signUpForm-password_confirm">Heslo znovu</label>
                    <input n:name="password_confirm" class="auth-input" placeholder="Zopakujte heslo">
                </div>

                {* Checkboxes *}
                <div class="auth-checkbox-group">
                    <label class="auth-checkbox-label">
                        <input n:name="newsletter" type="checkbox" class="auth-checkbox">
                        <span>Chci odebírat novinky a informace o akcích e-mailem</span>
                    </label>
                </div>

                <div class="auth-checkbox-group">
                    <label class="auth-checkbox-label">
                        <input n:name="terms" type="checkbox" class="auth-checkbox">
                        <span>Souhlasím s <a href="#" target="_blank">podmínkami použití</a> a <a href="#" target="_blank">zpracováním osobních údajů</a></span>
                    </label>
                </div>

                {* Error messages *}
                {if $form->hasErrors()}
                    <div class="auth-error">
                        <ul>
                            {foreach $form->errors as $error}
                                <li>{$error}</li>
                            {/foreach}
                        </ul>
                    </div>
                {/if}

                {* Submit *}
                <button n:name="send" class="auth-submit-btn">
                    Zaregistrovat se
                </button>
            {/form}

            {* Footer *}
            <div class="auth-footer">
                <p class="auth-footer-text">
                    Už máte účet?
                    <a n:href="Sign:in" class="auth-footer-link">Přihlaste se</a>
                </p>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var emailInput = document.getElementById('frm-signUpForm-email');
    var status = document.getElementById('email-status');
    if (!emailInput || !status) return;

    var timer = null;
    var lastChecked = '';

    emailInput.addEventListener('input', function() {
        clearTimeout(timer);
        var email = emailInput.value.trim();

        if (!email || !email.includes('@') || !email.includes('.')) {
            status.style.display = 'none';
            emailInput.style.borderColor = '';
            return;
        }

        timer = setTimeout(function() {
            if (email === lastChecked) return;
            lastChecked = email;

            fetch({link checkEmail!} + '&email=' + encodeURIComponent(email))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.exists) {
                        status.textContent = 'Uživatel s tímto e-mailem již existuje.';
                        status.className = 'auth-email-status email-taken';
                        status.style.display = 'block';
                        emailInput.style.borderColor = '#ef4444';
                        if (typeof showToast === 'function') showToast('Tento e-mail je již zaregistrován.', 'warning');
                    } else {
                        status.textContent = 'E-mail je volný.';
                        status.className = 'auth-email-status email-free';
                        status.style.display = 'block';
                        emailInput.style.borderColor = '#22c55e';
                    }
                })
                .catch(function() {
                    status.style.display = 'none';
                    emailInput.style.borderColor = '';
                });
        }, 500);
    });
});
</script>
{/block}
