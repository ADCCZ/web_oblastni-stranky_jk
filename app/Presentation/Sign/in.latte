{block content}
<div class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            {* Back to home *}
            <a n:href="Home:" class="auth-home-btn" title="Zpět na hlavní stránku">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
            </a>

            {* Header *}
            <div class="auth-header">
                <div class="auth-logo">
                    <img src="{$basePath}/images/logo.png" alt="Jižní Kříž">
                </div>
                <h1 class="auth-title font-display">Přihlášení</h1>
                <p class="auth-subtitle">Vítejte zpět v Jižním Kříži</p>
            </div>

            {* Flash messages *}
            {foreach $flashes as $flash}
                <div class="auth-flash auth-flash-{$flash->type}">
                    {$flash->message}
                </div>
            {/foreach}

            {* Login method tabs *}
            <div class="auth-method-tabs">
                <button type="button" class="auth-method-tab active" id="tab-form" onclick="switchLoginMethod('form')">
                    <svg class="auth-method-tab-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    E-mailem
                </button>
                <button type="button" class="auth-method-tab" id="tab-external" onclick="switchLoginMethod('external')">
                    <svg class="auth-method-tab-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                    </svg>
                    Externím účtem
                </button>
            </div>

            {* Panel: E-mail form *}
            <div id="panel-form" class="auth-method-panel">
                {form signInForm}
                    <div class="auth-form-group">
                        <label class="auth-label" for="frm-signInForm-email">E-mail</label>
                        <input n:name="email" class="auth-input" placeholder="vas@email.cz">
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label" for="frm-signInForm-password">Heslo</label>
                        <input n:name="password" class="auth-input" placeholder="Vaše heslo">
                    </div>

                    <div class="auth-options-row">
                        <label class="auth-checkbox-label">
                            <input n:name="remember" type="checkbox" class="auth-checkbox">
                            <span>Zapamatovat si mě</span>
                        </label>
                        <a n:href="Password:reset" class="auth-forgot-link">Zapomenuté heslo?</a>
                    </div>

                    {if $form->hasErrors()}
                        <div class="auth-error">
                            <ul>
                                {foreach $form->errors as $error}
                                    <li>{$error}</li>
                                {/foreach}
                            </ul>
                        </div>
                    {/if}

                    <button n:name="send" class="auth-submit-btn">
                        Přihlásit se
                    </button>
                {/form}
            </div>

            {* Panel: External login *}
            <div id="panel-external" class="auth-method-panel" style="display: none;">
                <p class="auth-external-desc">Vyberte službu, přes kterou se chcete přihlásit:</p>

                <div class="social-login-stack">
                    <a n:href="Sign:oauth provider => google" class="social-login-btn-full google">
                        <svg viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        <span>Pokračovat přes Google</span>
                    </a>

                    <a n:href="Sign:oauth provider => facebook" class="social-login-btn-full facebook">
                        <svg fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                        <span>Pokračovat přes Facebook</span>
                    </a>

                    <a n:href="Sign:oauth provider => discord" class="social-login-btn-full discord">
                        <svg fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                        </svg>
                        <span>Pokračovat přes Discord</span>
                    </a>
                </div>
            </div>

            {* Footer *}
            <div class="auth-footer">
                <p class="auth-footer-text">
                    Nemáte účet?
                    <a n:href="Sign:up" class="auth-footer-link">Zaregistrujte se</a>
                </p>
            </div>
        </div>
    </div>
</div>

<script>
function switchLoginMethod(method) {
    var tabForm = document.getElementById('tab-form');
    var tabExternal = document.getElementById('tab-external');
    var panelForm = document.getElementById('panel-form');
    var panelExternal = document.getElementById('panel-external');

    if (method === 'form') {
        tabForm.classList.add('active');
        tabExternal.classList.remove('active');
        panelForm.style.display = 'block';
        panelExternal.style.display = 'none';
    } else {
        tabExternal.classList.add('active');
        tabForm.classList.remove('active');
        panelExternal.style.display = 'block';
        panelForm.style.display = 'none';
    }
}

// Pokud ma formulář chyby, automaticky zobrazit formulářový panel
document.addEventListener('DOMContentLoaded', function() {
    if (document.querySelector('#panel-form .auth-error')) {
        switchLoginMethod('form');
    }
});
</script>
{/block}
