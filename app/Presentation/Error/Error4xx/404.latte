{block content}

<section class="error-page-section">
    <div class="error-page-container">
        <div class="error-compass" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="error-compass-svg">
                <defs>
                    <radialGradient id="ec-rim-grad" cx="35%" cy="30%" r="75%">
                        <stop offset="0%" stop-color="#fff2a8"/>
                        <stop offset="45%" stop-color="#ffd600"/>
                        <stop offset="100%" stop-color="#c99e00"/>
                    </radialGradient>
                    <radialGradient id="ec-face-grad" cx="38%" cy="32%" r="75%">
                        <stop offset="0%" stop-color="#ffffff"/>
                        <stop offset="75%" stop-color="#f3f5f8"/>
                        <stop offset="100%" stop-color="#dfe4ea"/>
                    </radialGradient>
                    <radialGradient id="ec-pin-grad" cx="35%" cy="30%" r="70%">
                        <stop offset="0%" stop-color="#6b7280"/>
                        <stop offset="55%" stop-color="#1f2937"/>
                        <stop offset="100%" stop-color="#0b0f16"/>
                    </radialGradient>
                </defs>
                <circle cx="100" cy="100" r="94" class="error-compass-rim"/>
                <circle cx="100" cy="100" r="80" class="error-compass-face"/>
                <g class="error-compass-ticks-minor">
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(15 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(30 100 100)"/>
                    <line x1="100" y1="68" x2="100" y2="76" transform="rotate(45 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(60 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(75 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(105 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(120 100 100)"/>
                    <line x1="100" y1="68" x2="100" y2="76" transform="rotate(135 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(150 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(165 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(195 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(210 100 100)"/>
                    <line x1="100" y1="68" x2="100" y2="76" transform="rotate(225 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(240 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(255 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(285 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(300 100 100)"/>
                    <line x1="100" y1="68" x2="100" y2="76" transform="rotate(315 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(330 100 100)"/>
                    <line x1="100" y1="72" x2="100" y2="76" transform="rotate(345 100 100)"/>
                </g>
                <g class="error-compass-ticks">
                    <line x1="100" y1="24" x2="100" y2="36"/>
                    <line x1="100" y1="164" x2="100" y2="176"/>
                    <line x1="24" y1="100" x2="36" y2="100"/>
                    <line x1="164" y1="100" x2="176" y2="100"/>
                </g>
                <text x="100" y="52" class="error-compass-label">N</text>
                <text x="100" y="158" class="error-compass-label error-compass-label-south">S</text>
                <text x="42" y="105" class="error-compass-label">W</text>
                <text x="158" y="105" class="error-compass-label">E</text>
                <g class="error-compass-needle">
                    <polygon points="100,40 108,100 100,108 92,100" class="error-compass-needle-north"/>
                    <polygon points="100,160 108,100 100,92 92,100" class="error-compass-needle-south"/>
                    <line x1="100" y1="44" x2="100" y2="100" class="error-compass-needle-shine"/>
                </g>
                <circle cx="100" cy="100" r="7" class="error-compass-pin"/>
            </svg>
        </div>

        <p class="error-code">404</p>
        <h1 n:block=title class="error-title font-display">Zdá se, že jste sešli ze stezky</h1>
        <p class="error-subtitle">Tahle stopa nikam nevede - stránka, kterou hledáte, tu není, byla přesunuta, nebo nikdy neexistovala.</p>

        <a href="{$basePath}/" class="error-home-link">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            Zpět na hlavní stránku
        </a>
    </div>
</section>

<style>
    .error-page-section {
        position: relative;
        z-index: 10;
        padding-top: var(--page-content-top);
        padding-bottom: var(--page-content-top);
        min-height: 100vh;
        box-sizing: border-box;
        display: flex;
        align-items: center;
    }

    .error-page-container {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 clamp(16px, 4vw, 32px);
        text-align: center;
    }

    .error-compass {
        width: clamp(140px, 20vw, 210px);
        margin: 0 auto clamp(24px, 3.5vw, 40px);
    }

    .error-compass-svg {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.15));
    }

    .error-compass-rim {
        fill: url(#ec-rim-grad);
        stroke: #a67c00;
        stroke-width: 2;
    }

    .error-compass-face {
        fill: url(#ec-face-grad);
        stroke: #d3d8de;
        stroke-width: 1;
    }

    .dark .error-compass-face {
        fill: #1e293b;
        stroke: #334155;
    }

    .error-compass-ticks line {
        stroke: #64748b;
        stroke-width: 2;
    }

    .error-compass-ticks-minor line {
        stroke: #9aa7b6;
        stroke-width: 1;
    }

    .dark .error-compass-ticks-minor line {
        stroke: #475569;
    }

    .error-compass-label {
        font-size: 14px;
        font-weight: 700;
        fill: #64748b;
        text-anchor: middle;
        font-family: inherit;
    }

    /* Jižní Kříž - jih je "domovský" směr, proto S vystupuje víc než ostatní
       světové strany (a jehla se v animaci níž vždy vrací právě k němu). */
    .error-compass-label-south {
        fill: var(--primary, #0075b5);
        font-size: 16px;
    }

    .error-compass-needle {
        transform-origin: 100px 100px;
        animation: compassSearch 3.5s ease-in-out infinite;
    }

    .error-compass-needle-north {
        fill: #dc2626;
        stroke: #9f1c1c;
        stroke-width: 0.5;
    }

    .error-compass-needle-south {
        fill: #94a3b8;
        stroke: #64748b;
        stroke-width: 0.5;
    }

    .error-compass-needle-shine {
        stroke: #ffffff;
        stroke-width: 1;
        opacity: 0.5;
    }

    .error-compass-pin {
        fill: url(#ec-pin-grad);
        stroke: #000000;
        stroke-width: 0.5;
    }

    .dark .error-compass-pin {
        fill: #e2e8f0;
        stroke: none;
    }

    /* Jehla bloudí, ale vždy se vrátí k jihu (180° = červený hrot dole na
       "S") místo k severu - Jižní Kříž, tak ať se aspoň kompas vždycky umí
       trefit domů. */
    @keyframes compassSearch {
        0%   { transform: rotate(180deg); }
        20%  { transform: rotate(215deg); }
        40%  { transform: rotate(155deg); }
        60%  { transform: rotate(195deg); }
        80%  { transform: rotate(170deg); }
        100% { transform: rotate(180deg); }
    }

    .error-code {
        font-size: clamp(2.5rem, 7vw, 3.75rem);
        font-weight: 800;
        color: var(--primary, #0075b5);
        letter-spacing: 0.05em;
        margin-bottom: 8px;
    }

    .error-title {
        font-size: clamp(1.8rem, 4.5vw, 2.75rem);
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 16px;
    }

    .error-subtitle {
        color: var(--text-secondary);
        font-size: clamp(1rem, 1.8vw, 1.25rem);
        line-height: 1.6;
        margin-bottom: clamp(28px, 4vw, 40px);
    }

    .error-home-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: clamp(12px, 1.6vw, 16px) clamp(28px, 3vw, 36px);
        background: linear-gradient(135deg, #0075b5 0%, #005a8c 100%);
        color: white;
        font-weight: 600;
        font-size: clamp(1rem, 1.4vw, 1.15rem);
        border-radius: 12px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(0, 117, 181, 0.3);
        transition: all 0.2s ease;
    }

    .error-home-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 117, 181, 0.4);
    }
</style>
